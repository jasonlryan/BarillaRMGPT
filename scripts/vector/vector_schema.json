  "definitions": {
    "triggers": {
      "description": "Purchase triggers are events or motivations that prompt a consumer to buy a product.",
      "examples": [
        "I was making plans for what snacks were needed",
        "I was asked to buy it by someone in my household"
      ]
    },
    "occasions": {
      "description": "Consumption occasions are specific times or events when a product is typically consumed.",
      "examples": [
        "With Coffee",
        "During a party"
      ]
    },
    "needs": {
      "description": "Consumer needs are the underlying motivations or requirements that drive product purchases.",
      "examples": [
        "Need for convenience",
        "Desire for a healthy snack"
      ]
    },
    "inspiration": {
      "description": "Inspiration sources are influences that encourage consumers to try or purchase a product.",
      "examples": [
        "Saw a recipe online",
        "Recommended by a friend"
      ]
    },
    "pairings": {
      "description": "Pairings are combinations of products that are commonly consumed together.",
      "examples": [
        "With Tea",
        "With Cheese"
      ]
    }
  },
