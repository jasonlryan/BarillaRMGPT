  "validationRules": {
    "geographic": {
      "enforceGranularity": true,
      "allowedLevels": {
        "national": true,
        "region": true,
        "state": false,
        "city": false,
        "county": false
      },
      "requiredValidation": {
        "beforeQuery": [
          "Check geographic level in query against allowedLevels",
          "If level not allowed, return rejection message immediately",
          "Do not proceed with data lookup until geographic validation passes"
        ],
        "duringResponse": [
          "Must explicitly state geographic level of data being provided",
          "Must include geographic scope disclaimer in response",
          "Cannot mix data from different geographic levels without explicit labeling"
        ],
        "rejectionResponses": {
          "state": "This data is not available at the state level. The Vista Grande study only provides insights at national and regional levels (Northeast, Midwest, South, West). Would you like me to share the relevant regional data instead?",
          "city": "This data is not available at the city level. The Vista Grande study only provides insights at national and regional levels (Northeast, Midwest, South, West). Would you like me to share the relevant regional data instead?",
          "county": "This data is not available at the county level. The Vista Grande study only provides insights at national and regional levels (Northeast, Midwest, South, West). Would you like me to share the relevant regional data instead?"
        }
      },
      "responseTemplates": {
        "offerRegionalAlternative": "While we don't have data for [State], I can provide insights for the [Region] region where [State] is located. Would you like to see that data instead?",
        "nationalDataDisclaimer": "Note: The following insights are based on national-level data and may not reflect specific conditions in [Location].",
        "multiLevelData": "This response includes both national-level trends ([NationalMetric]) and regional data for [Region] ([RegionalMetric]). Each insight is explicitly labeled with its geographic scope."
      }
    }
  }
